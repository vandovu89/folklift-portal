generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Forklift {
  id              String    @id @default(uuid())
  
  // Thông tin nhận diện
  internalCode    String?
  stockNo         String?
  serialNo        String?
  maker           String
  model           String
  year            Int?
  hour            Int?

  // Phân loại
  category        String?
  type            String?
  powerType       String?
  productGroup    String?

  // Thông số kỹ thuật
  mast            String?
  liftHeight      String?
  loadCapacity    String?
  attachment      String?
  forkLength      String?
  dimensions      String?
  weight          String?
  otherSpecs      String?

  // Nguồn hàng (Nội bộ)
  purchaseSource  String?
  sourceUrl       String?
  offerDeadline   DateTime?
  purchaseDate    DateTime?
  supplier        String?

  // Vị trí & Trạng thái
  location        String?
  status          String    @default("Draft")
  
  // Tình trạng (Cơ bản cho Phase 1)
  condition       String?
  engineCondition String?

  // Giá (Bảo mật tùy role)
  price           Float?

  // Quan hệ
  media           Media[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Media {
  id          String   @id @default(uuid())
  url         String
  fileName    String?
  fileType    String   // 'IMAGE' hoặc 'DOCUMENT'
  category    String?  // Tổng thể, Kỹ thuật, Tình trạng, Inspection Report...
  isPublic    Boolean  @default(false)
  publicId    String?  // Dùng cho Cloudinary
  
  forkliftId  String
  forklift    Forklift @relation(fields: [forkliftId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
}
