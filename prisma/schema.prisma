generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Forklift {
  id              String    @id @default(uuid())
  
  // Thông tin nhận diện
  internalCode    String?
  stockNo         String?
  serialNo        String?
  maker           String
  model           String
  year            Int?
  hour            Int?

  // Phân loại
  category        String?
  type            String?
  powerType       String?
  productGroup    String?

  // Thông số kỹ thuật
  mast            String?
  liftHeight      String?
  loadCapacity    String?
  attachment      String?
  forkLength      String?
  dimensions      String?
  weight          String?
  otherSpecs      String?

  // Nguồn hàng (Nội bộ)
  purchaseSource  String?
  sourceUrl       String?
  offerDeadline   DateTime?
  purchaseDate    DateTime?
  supplier        String?

  // Vị trí & Trạng thái
  location        String?
  status          String    @default("Published")
  
  // Tình trạng (Cơ bản cho Phase 1)
  condition       String?
  engineCondition String?

  // Giá (Bảo mật tùy role)
  price           Float?

  // Quan hệ
  media           Media[]
  inquiries       Inquiry[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Inquiry {
  id             String        @id @default(uuid())
  customerName   String
  phone          String?
  email          String?
  company        String?
  message        String?
  status         String        @default("New") // New, Contacted, Negotiating, Quoted, Won, Lost
  
  forkliftId     String?
  forklift       Forklift?     @relation(fields: [forkliftId], references: [id], onDelete: SetNull)
  
  facebookPageId String?
  facebookPage   FacebookPage? @relation(fields: [facebookPageId], references: [id], onDelete: SetNull)

  chatSession    ChatSession?

  notes          String?       // Ghi chú nội bộ cho Sales
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Media {
  id          String   @id @default(uuid())
  url         String
  fileName    String?
  fileType    String   // 'IMAGE' hoặc 'DOCUMENT'
  category    String?  // Tổng thể, Kỹ thuật, Tình trạng, Inspection Report...
  isPublic    Boolean  @default(false)
  publicId    String?  // Dùng cho Cloudinary
  
  forkliftId  String
  forklift    Forklift @relation(fields: [forkliftId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
}

model FacebookPage {
  id          String        @id @default(uuid())
  pageId      String        @unique // Meta Facebook Page ID
  pageName    String                // Tên gợi nhớ
  accessToken String                // Page Access Token riêng của Page
  isActive    Boolean       @default(true) // Bật/tắt bot cho page này
  greeting    String?               // Lời chào mở đầu tuỳ chỉnh cho page

  sessions    ChatSession[]
  inquiries   Inquiry[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ChatSession {
  id             String        @id @default(uuid())
  channel        String        @default("MESSENGER") // "MESSENGER" | "WEB"
  senderId       String        // Facebook PSID hoặc web session ID

  facebookPageId String?
  facebookPage   FacebookPage? @relation(fields: [facebookPageId], references: [id], onDelete: SetNull)

  messages       ChatMessage[]

  inquiryId      String?       @unique
  inquiry        Inquiry?      @relation(fields: [inquiryId], references: [id], onDelete: SetNull)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model ChatMessage {
  id        String      @id @default(uuid())
  role      String      // "user" | "assistant"
  content   String
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime    @default(now())
}

